{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.learnstackhub.com"
        }
      ],
      "destination": "https://learnstackhub.com/:path*",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/tutorial/hibernate-session/",
      "destination": "/tutorial/hibernate-session",
      "permanent": true
    },
    {
      "source": "/tutorial/servlet-architecture",
      "destination": "/tutorial/servlet-introduction",
      "permanent": true
    },
    {
      "source": "/tutorial/servlet-filter",
      "destination": "/tutorial/filters-listeners",
      "permanent": true
    },
    {
      "source": "/tutorial/servlet-listener",
      "destination": "/tutorial/filters-listeners",
      "permanent": true
    },
    {
      "source": "/tutorial/jdbc-architecture",
      "destination": "/tutorial/jdbc-introduction",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

