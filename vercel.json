{
  "functions": {
    "api/sync-user.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/_lib/**"
    },
    "api/admin-users.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/_lib/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "learnstackhub.com"
        }
      ],
      "destination": "https://www.learnstackhub.com/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tutorial/servlet-architecture",
      "destination": "/tutorial/servlet-introduction",
      "permanent": true
    },
    {
      "source": "/tutorial/servlet-filter",
      "destination": "/tutorial/filters-listeners",
      "permanent": true
    },
    {
      "source": "/tutorial/servlet-listener",
      "destination": "/tutorial/filters-listeners",
      "permanent": true
    },
    {
      "source": "/tutorial/jdbc-architecture",
      "destination": "/tutorial/jdbc-introduction",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://learnstackhub.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

