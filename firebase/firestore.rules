rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminEmail() {
      return request.auth != null && (
        request.auth.token.email == 'genaixis@gmail.com' ||
        request.auth.token.email == 'careers@learnstackhub.com' ||
        request.auth.token.email == 'pandidattakumar906@gmail.com'
      );
    }

    function isAdmin() {
      return isAdminEmail() || (
        request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow create: if request.auth != null
        && request.auth.uid == adminId
        && isAdminEmail()
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.subscription == resource.data.subscription;

      allow delete: if false;
    }
  }
}
