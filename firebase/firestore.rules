rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function normalizedEmail() {
      return request.auth.token.email.lower();
    }

    function isAdminEmail() {
      return request.auth != null && (
        normalizedEmail() == 'genaixis@gmail.com' ||
        normalizedEmail() == 'careers@learnstackhub.com' ||
        normalizedEmail() == 'pandidattakumar906@gmail.com'
      );
    }

    function isAdmin() {
      return isAdminEmail() || (
        request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow create: if request.auth != null
        && request.auth.uid == adminId
        && isAdminEmail()
        && request.resource.data.email.lower() == normalizedEmail();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.subscription == resource.data.subscription;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /recruitmentExams/{examId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
