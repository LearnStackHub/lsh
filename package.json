{
  "name": "learnstackhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:ui": "vite",
    "dev:api": "node --watch --env-file=.env scripts/local-api-server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "build-indexing-candidates": "node scripts/build-indexing-candidates.js",
    "generate-sitemap:review": "STRICT_INDEXING_POLICY=1 node scripts/generate-sitemap.js",
    "recheck-review-readiness": "STRICT_INDEXING_POLICY=1 node scripts/recheck-review-readiness.js",
    "test:razorpay": "node --env-file=.env scripts/test-razorpay-local.js",
    "prepare:firebase-env": "node scripts/prepare-firebase-vercel-env.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@emailjs/browser": "^4.4.1",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@uiw/react-codemirror": "^4.25.4",
    "alasql": "^4.17.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  },
  "overrides": {
    "jwks-rsa": "3.2.0",
    "jose": "4.15.9"
  }
}
