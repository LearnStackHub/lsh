# Practice Lab chat — server-only variables (never commit real secrets; never expose keys in the browser).
# Set these in your hosting provider’s project / environment settings.
#
# OLLAMA_API_KEY=        # required for chat
# OLLAMA_MODEL=         # optional; default used if unset
# OLLAMA_API_URL=       # optional API base override
# OLLAMA_SYSTEM_PROMPT= # optional tutor instructions (capped on server)
#
# For full local dev (UI + /api routes including Razorpay checkout): npm run dev
# UI only: npm run dev:ui  |  API only: npm run dev:api
# Checkout also needs FIREBASE_SERVICE_ACCOUNT in .env (same as Vercel).

# SEO indexing policy (optional)
# VITE_STRICT_INDEXING_POLICY=1

# Firebase — enable Authentication → Sign-in method → Google AND Email/Password
#
# REQUIRED in Firebase Console → Authentication → Settings → Authorized domains:
#   localhost
#   www.learnstackhub.com
#   learnstackhub.com
#   (optional) your-project.vercel.app
#
# Do NOT set VITE_FIREBASE_AUTH_DOMAIN locally unless debugging — default is
# learnstackhub.firebaseapp.com on localhost and www.learnstackhub.com in production.
#
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Web client (Firebase):
#   Authorized JavaScript origins:
#     http://localhost:5173
#     http://127.0.0.1:5173
#     https://www.learnstackhub.com
#     https://learnstackhub.com
#   Authorized redirect URIs (add all three):
#     http://localhost:5173/__/auth/handler
#     https://learnstackhub.firebaseapp.com/__/auth/handler
#     https://www.learnstackhub.com/__/auth/handler
#
# IMPORTANT: one variable per line in Vercel (never paste two KEY=value pairs on one line).
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=learnstackhub
# VITE_FIREBASE_STORAGE_BUCKET=learnstackhub.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Admin dashboard (client route guard for /admin)
# VITE_ADMIN_EMAILS=you@gmail.com,careers@learnstackhub.com
#
# Optional: full member list on production host (server-only, never commit)
# Local dev (easiest): download JSON from Firebase Console → save as firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option A — full JSON on one line (recommended for Vercel):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"learnstackhub",...}
# Option B — split fields (easier to paste on some hosts):
# FIREBASE_PROJECT_ID=learnstackhub
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@learnstackhub.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# ADMIN_EMAILS=you@gmail.com,careers@learnstackhub.com
#
# Razorpay — subscriptions (https://dashboard.razorpay.com/)
# Client (public key only):
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx
# VITE_SITE_URL=https://www.learnstackhub.com
# VITE_RAZORPAY_PLAN_6MONTHS_EARLY_INR=999
# VITE_RAZORPAY_PLAN_6MONTHS_INR=1499
# VITE_RAZORPAY_PLAN_12MONTHS_EARLY_INR=34999
# VITE_RAZORPAY_PLAN_12MONTHS_INR=49999
# VITE_RAZORPAY_PLAN_6MONTHS_EARLY_USD=12
# VITE_RAZORPAY_PLAN_6MONTHS_USD=18
# VITE_RAZORPAY_PLAN_12MONTHS_EARLY_USD=420
# VITE_RAZORPAY_PLAN_12MONTHS_USD=600
# VITE_SUBSCRIBER_EARLY_BIRD_LIMIT=100
# VITE_REQUIRE_SUBSCRIPTION=false
# VITE_MENTOR_WHATSAPP=918466932302
# VITE_MENTOR_PHONE_DISPLAY=8466932302
# VITE_MENTOR_PHONE_TEL=8466932302
# VITE_MENTOR_SCHEDULE_URL=https://calendly.com/your-link
#
# Server-only (Vercel Production + Preview):
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=your_secret
# RAZORPAY_PLAN_6MONTHS_EARLY_PAISE=99900
# RAZORPAY_PLAN_6MONTHS_PAISE=149900
# RAZORPAY_PLAN_12MONTHS_EARLY_PAISE=3499900
# RAZORPAY_PLAN_12MONTHS_PAISE=4999900
# RAZORPAY_PLAN_6MONTHS_EARLY_USD_CENTS=1200
# RAZORPAY_PLAN_6MONTHS_USD_CENTS=1800
# RAZORPAY_PLAN_12MONTHS_EARLY_USD_CENTS=42000
# RAZORPAY_PLAN_12MONTHS_USD_CENTS=60000
# SUBSCRIBER_EARLY_BIRD_LIMIT=100
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxx
# Webhook URL: https://www.learnstackhub.com/api/razorpay-webhook
# Webhook event: payment.captured
#
# Cashfree — subscriptions (https://merchant.cashfree.com/merchants/pg/developers/api-keys)
# Active gateway is chosen in Admin → Payment gateway (Firestore siteSettings/payment).
# Server-only (never expose secret in Vite):
# CASHFREE_APP_ID=your_app_id
# CASHFREE_CLIENT_ID=        # optional alias for CASHFREE_APP_ID
# CASHFREE_SECRET_KEY=your_secret
# CASHFREE_ENV=sandbox       # or production
# DEFAULT_PAYMENT_GATEWAY=razorpay  # optional fallback before admin saves a choice
