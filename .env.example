# Practice Lab — real chat (Vercel serverless → Ollama Cloud)
# Set these in the Vercel dashboard (Production + Preview). Do NOT expose the API key to the browser.
#
# OLLAMA_API_KEY=        # required — https://ollama.com/settings/keys
# OLLAMA_MODEL=llama3.2 # optional; use a model your Ollama Cloud account can run
# OLLAMA_API_URL=       # optional override, default https://ollama.com/api/chat
# OLLAMA_SYSTEM_PROMPT= # optional tutor instructions (long text ok; capped on server)
#
# Local: run `vercel dev` from the repo root so `/api/ollama-chat` exists; plain `npm run dev` has no API.
