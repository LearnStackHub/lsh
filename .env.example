# Practice Lab chat — server-only variables (never commit real secrets; never expose keys in the browser).
# Set these in your hosting provider’s project / environment settings.
#
# OLLAMA_API_KEY=        # required for chat
# OLLAMA_MODEL=         # optional; default used if unset
# OLLAMA_API_URL=       # optional API base override
# OLLAMA_SYSTEM_PROMPT= # optional tutor instructions (capped on server)
#
# For full chat locally, use a setup where `/api` routes run; `npm run dev` alone serves the UI only.

# SEO indexing policy (optional)
# VITE_STRICT_INDEXING_POLICY=1

# Firebase — enable Authentication → Sign-in method → Google
#
# REQUIRED in Firebase Console → Authentication → Settings → Authorized domains:
#   localhost
#   www.learnstackhub.com
#   learnstackhub.com
#   (optional) your-project.vercel.app
#
# Do NOT set VITE_FIREBASE_AUTH_DOMAIN on Vercel — app uses learnstackhub.firebaseapp.com
#
# Google Cloud → APIs & Services → Credentials → OAuth Web client:
#   Authorized JavaScript origins: https://www.learnstackhub.com, https://learnstackhub.com, http://localhost:5173
#   Authorized redirect URI: https://learnstackhub.firebaseapp.com/__/auth/handler
#
# IMPORTANT: one variable per line in Vercel (never paste two KEY=value pairs on one line).
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=learnstackhub
# VITE_FIREBASE_STORAGE_BUCKET=learnstackhub.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Admin dashboard (client route guard for /admin)
# VITE_ADMIN_EMAILS=you@gmail.com,careers@learnstackhub.com
#
# Optional: full member list on production host (server-only, never commit)
# Option A — full JSON on one line (recommended):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"learnstackhub",...}
# Option B — split fields (easier to paste on some hosts):
# FIREBASE_PROJECT_ID=learnstackhub
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@learnstackhub.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# ADMIN_EMAILS=you@gmail.com,careers@learnstackhub.com
